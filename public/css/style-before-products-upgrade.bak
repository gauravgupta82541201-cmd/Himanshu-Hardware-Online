*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;background:#f7f8fc;color:#111827}a{text-decoration:none;color:inherit}button,input,select,textarea{font:inherit}.wrap{width:min(1180px,92%);margin:auto}header{background:#08111f;color:#fff;position:sticky;top:0;z-index:20}.nav{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;gap:10px;align-items:center;font-weight:900}.brand b{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,#ffb703,#fb5607);color:#111}.brand img{width:42px;height:42px;object-fit:contain;border-radius:12px;background:#fff}.brand small{display:block;color:#94a3b8;font-size:10px}.nav nav{display:flex;gap:18px;font-size:14px}.nav nav a:hover,.active{color:#f59e0b}.hero{background:linear-gradient(120deg,#07101e,#17364c);color:#fff;padding:90px 0}.grid{display:grid;grid-template-columns:1.2fr .8fr;gap:55px;align-items:center}.hero h1{font-size:clamp(42px,6vw,74px);line-height:1;margin:15px 0}.hero em{color:#f59e0b;font-style:normal}.hero p,.pagehero p{color:#bfcbda;line-height:1.7;font-size:17px}.hero-cover{background-size:cover;background-position:center}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:25px 0}.btn{border:0;border-radius:12px;padding:13px 18px;font-weight:800;display:inline-flex;justify-content:center;cursor:pointer}.primary{background:linear-gradient(135deg,#ffb703,#fb8500);color:#111}.light{background:#fff;color:#111}.outline{background:transparent;border:1px solid #d5dce6;color:#111}.dark .outline{color:#fff;border-color:#ffffff44}.stats{display:flex;gap:30px;flex-wrap:wrap}.stats span{display:flex;flex-direction:column;color:#9eabc0;font-size:12px}.stats b{color:#fff}.hero-card{padding:32px;border:1px solid #fff2;border-radius:25px;background:#ffffff0b}.hero-card>div{font-size:60px}.hero-card li{margin:12px 0}.section{padding:75px 0}.section h2{font-size:38px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.cards a,.info,.product,.login,.dashboard,.cart{background:#fff;border:1px solid #e1e7ee;border-radius:20px;padding:24px}.cards a{display:grid;gap:8px;font-size:27px}.cards span,.info span{color:#64748b;font-size:13px}.dark{background:#0b1220;color:#fff}.dark p{color:#aebbd0;line-height:1.7}.checks{display:grid;gap:12px}.checks div{padding:16px;border:1px solid #fff2;border-radius:12px}.cta{background:#eef2f7;border-radius:25px;padding:35px;display:flex;justify-content:space-between;align-items:center}.pagehero{background:#0b1220;color:#fff;padding:65px 0}.pagehero h1{font-size:55px;margin:10px 0}.filters{display:flex;gap:10px;margin-bottom:25px}.filters input,.filters select,.form input,.form textarea,.login input{padding:13px;border:1px solid #d9e0e9;border-radius:10px;width:100%}.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product{padding:0;overflow:hidden}.pic{height:170px;background:#e5ebf2;display:grid;place-items:center;font-size:50px}.pic img{width:100%;height:100%;object-fit:cover}.pbody{padding:17px}.pbody small{color:#64748b}.pbody h3{margin:7px 0}.pbody p{color:#64748b;font-size:12px;min-height:30px}.price{font-size:19px;font-weight:900;margin:13px 0}.price span{font-size:11px;color:#64748b;font-weight:500}.product .btn{width:100%}.cart-area{background:#eef2f7}.cart{padding:28px}.head{display:flex;justify-content:space-between;align-items:center;gap:15px}.cartrow{display:flex;justify-content:space-between;border-bottom:1px solid #edf0f4;padding:14px 0}.cartrow button{border:0;background:#edf1f6;border-radius:7px}.total{display:flex;justify-content:space-between;font-size:20px;padding:20px 0}.about,.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.about p,.info p{color:#59677a;line-height:1.8}.contact-grid{grid-template-columns:repeat(3,1fr)}footer{padding:28px 0;background:#060a12;color:#aab5c8}footer .wrap{display:flex;justify-content:space-between;gap:20px}.social{display:flex;gap:10px;flex-wrap:wrap}.social a{padding:9px 12px;border:1px solid #ffffff22;border-radius:9px}.admin-page{background:#f1f4f8;min-height:100vh}.adminbar{height:72px;padding:0 4%;display:flex;justify-content:space-between;align-items:center;background:#0b1220}.adminwrap{width:min(1100px,92%);margin:45px auto}.login{width:min(440px,100%);margin:70px auto}.login input{margin:15px 0}.full{width:100%}.dashboard{padding:30px}.tabs{display:flex;gap:10px;border-bottom:1px solid #e4e8ef;margin-bottom:20px}.tab{border:0;background:none;padding:12px;font-weight:800;cursor:pointer}.tab.active{border-bottom:3px solid #f59e0b}.panel h2{margin-top:0}.adminrow{display:grid;grid-template-columns:60px 1fr auto;gap:15px;align-items:center;border:1px solid #e4e8ef;border-radius:12px;padding:10px;margin-bottom:8px}.thumb{height:55px;background:#edf1f6;display:grid;place-items:center;overflow:hidden;border-radius:8px}.thumb img{width:100%;height:100%;object-fit:cover}.adminrow small{display:block;color:#64748b}.adminrow button{border:1px solid #ddd;background:#fff;border-radius:8px;padding:7px;cursor:pointer}.form{display:grid;grid-template-columns:1fr 1fr;gap:15px}.form label{font-size:13px;font-weight:800}.form textarea{min-height:100px}.wide{grid-column:1/-1}.overlay{position:fixed;inset:0;background:#0009;display:grid;place-items:center;padding:20px;z-index:50}.modal{background:#fff;padding:28px;border-radius:20px;width:min(600px,100%);position:relative}.x{position:absolute;right:12px;top:12px;border:0;border-radius:50%;cursor:pointer}.hidden{display:none!important}.toast{position:fixed;right:20px;bottom:20px;background:#0b1220;color:#fff;padding:12px 16px;border-radius:10px;z-index:60}.fab{position:fixed;right:18px;bottom:18px;background:#20c463;color:#fff;padding:15px 17px;border-radius:50%;box-shadow:0 8px 30px #0003;z-index:15}.status{padding:9px 12px;border-radius:9px;background:#eef2f7;color:#475569;font-size:12px}.status.online{background:#dcfce7;color:#166534}@media(max-width:850px){.grid,.about,.contact-grid{grid-template-columns:1fr}.cards,.product-grid{grid-template-columns:repeat(2,1fr)}.nav nav{gap:8px;font-size:12px}}@media(max-width:600px){.nav{padding:10px 0;align-items:flex-start}.nav nav{flex-wrap:wrap;justify-content:flex-end}.hero h1{font-size:43px}.section{padding:55px 0}.product-grid,.cards{grid-template-columns:1fr 1fr}.form{grid-template-columns:1fr}.wide{grid-column:auto}.pagehero h1{font-size:40px}footer .wrap{flex-direction:column}.stats{gap:15px}}
.top-social{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:12px 0;
}

.top-social-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.top-social-inner small{
  display:block;
  color:#64748b;
  font-size:10px;
  font-weight:800;
  letter-spacing:1px;
}

.top-social-inner strong{
  display:block;
  color:#111827;
  font-size:14px;
  margin-top:3px;
}

.top-social-links{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
}

.social-btn{
  display:inline-flex !important;
  align-items:center;
  justify-content:center;
  padding:9px 13px;
  border-radius:10px;
  border:1px solid #e2e8f0;
  background:#f8fafc;
  color:#111827;
  font-size:13px;
  font-weight:800;
}

.social-btn:hover{
  transform:translateY(-2px);
  box-shadow:0 5px 15px #00000012;
}

@media(max-width:600px){
  .top-social-inner{
    flex-direction:column;
    align-items:flex-start;
  }

  .top-social-links{
    width:100%;
  }

  .social-btn{
    flex:1;
    min-width:110px;
  }
}

/* ===== TOP SOCIAL PREMIUM ===== */

.top-social{
  position:relative;
  z-index:19;
  background:rgba(255,255,255,.97);
  border-bottom:1px solid #e5e7eb;
  box-shadow:0 3px 14px rgba(0,0,0,.05);
  padding:10px 0;
}

.top-social-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
}

.top-social-title small{
  display:block;
  color:#64748b;
  font-size:9px;
  font-weight:900;
  letter-spacing:1.2px;
}

.top-social-title strong{
  display:block;
  color:#111827;
  font-size:14px;
  margin-top:2px;
}

.top-social-links{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:8px;
  flex-wrap:wrap;
}

.social-btn{
  display:inline-flex !important;
  align-items:center;
  gap:7px;
  padding:7px 11px;
  border:1px solid #e2e8f0;
  border-radius:999px;
  background:#fff;
  color:#1e293b !important;
  font-size:12px;
  font-weight:800;
  transition:.2s ease;
}

.social-btn:hover{
  transform:translateY(-2px);
  box-shadow:0 6px 18px rgba(15,23,42,.10);
  border-color:#cbd5e1;
}

.social-icon{
  width:25px;
  height:25px;
  border-radius:50%;
  display:grid;
  place-items:center;
  flex:none;
  font-weight:900;
  color:#fff;
  font-size:13px;
}

.instagram-icon{
  background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);
}

.facebook-icon{
  background:#1877f2;
  font-family:Arial,sans-serif;
  font-size:17px;
}

.youtube-icon{
  background:#ff0000;
  font-size:10px;
}

.website-icon{
  background:#0f172a;
  font-size:12px;
}


/* ===== MOBILE COMPACT DESIGN ===== */

@media(max-width:600px){

  .wrap{
    width:calc(100% - 28px);
  }

  .top-social{
    padding:8px 0;
  }

  .top-social-inner{
    flex-direction:column;
    align-items:stretch;
    gap:8px;
  }

  .top-social-title{
    display:flex;
    align-items:center;
    justify-content:space-between;
  }

  .top-social-title strong{
    font-size:12px;
  }

  .top-social-links{
    width:100%;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:6px;
  }

  .social-btn{
    padding:6px 3px;
    border-radius:12px;
    flex-direction:column;
    gap:3px;
    font-size:9px;
  }

  .social-icon{
    width:28px;
    height:28px;
  }

  .nav{
    min-height:62px;
    gap:8px;
  }

  .brand b,
  .brand img{
    width:36px;
    height:36px;
  }

  .brand{
    gap:7px;
    font-size:13px;
  }

  .brand small{
    font-size:8px;
  }

  .nav nav{
    gap:5px;
    font-size:10px;
  }

  .hero{
    padding:48px 0 45px;
  }

  .hero h1{
    font-size:38px;
    line-height:1.04;
    margin:12px 0;
  }

  .hero p,
  .pagehero p{
    font-size:14px;
    line-height:1.6;
  }

  .hero-card{
    padding:20px;
    border-radius:18px;
  }

  .hero-card>div{
    font-size:45px;
  }

  .section{
    padding:42px 0;
  }

  .section h2{
    font-size:28px;
  }

  .cards{
    gap:10px;
  }

  .cards a{
    padding:16px;
    border-radius:15px;
    font-size:21px;
  }

  .cards span{
    font-size:11px;
  }

  .actions{
    margin:18px 0;
  }

  .btn{
    padding:11px 14px;
    border-radius:10px;
    font-size:13px;
  }

  .stats{
    gap:14px;
  }

  .stats span{
    font-size:10px;
  }

  .cta{
    padding:22px;
    border-radius:18px;
  }

  .cta h2{
    font-size:25px;
  }

  footer{
    padding:22px 0;
    font-size:12px;
  }
}


/* ===== PREMIUM MOBILE HERO ===== */
@media (max-width: 600px){

  .hero{
    padding:32px 0 30px;
    background:
      radial-gradient(circle at 90% 10%, rgba(245,158,11,.16), transparent 32%),
      linear-gradient(145deg,#07101e,#102b3d);
  }

  .hero .grid{
    gap:22px;
  }

  .hero h1{
    font-size:32px;
    line-height:1.08;
    letter-spacing:-.8px;
    margin:10px 0 12px;
  }

  .hero > .wrap > div:first-child > small{
    font-size:9px;
    letter-spacing:.5px;
    opacity:.85;
  }

  .hero p{
    font-size:13px;
    line-height:1.55;
    margin:0;
    color:#cbd5e1;
  }

  .hero .actions{
    gap:8px;
    margin:16px 0;
  }

  .hero .btn{
    padding:10px 13px;
    font-size:12px;
    border-radius:10px;
  }

  .hero .stats{
    gap:10px;
    margin-top:12px;
  }

  .hero .stats span{
    font-size:9px;
    padding-right:9px;
    border-right:1px solid rgba(255,255,255,.12);
  }

  .hero .stats span:last-child{
    border-right:0;
  }

  .hero .stats b{
    font-size:11px;
    margin-bottom:2px;
  }

  .hero-card{
    padding:17px;
    border-radius:17px;
    background:rgba(255,255,255,.055);
    border:1px solid rgba(255,255,255,.10);
    box-shadow:0 12px 30px rgba(0,0,0,.16);
  }

  .hero-card > div{
    font-size:36px;
    line-height:1;
  }

  .hero-card h2{
    font-size:20px;
    margin:9px 0 5px;
  }

  .hero-card p{
    font-size:11px;
    margin-bottom:8px;
  }

  .hero-card ul{
    margin:8px 0 0;
    padding-left:18px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:4px 12px;
  }

  .hero-card li{
    font-size:11px;
    margin:3px 0;
  }
}

/* Extra-small phones */
@media (max-width:380px){

  .hero{
    padding:27px 0 25px;
  }

  .hero h1{
    font-size:29px;
  }

  .hero p{
    font-size:12px;
  }

  .hero .stats{
    gap:7px;
  }

  .hero .stats span{
    font-size:8px;
    padding-right:6px;
  }

  .hero .stats b{
    font-size:10px;
  }

  .hero-card{
    padding:14px;
  }

  .hero-card h2{
    font-size:18px;
  }

  .hero-card li{
    font-size:10px;
  }
}


/* ===== KEEP HOME SOCIAL BAR VISIBLE ===== */
.top-social{
  display:block !important;
  visibility:visible !important;
  opacity:1 !important;
}

.top-social .top-social-inner{
  display:flex !important;
  visibility:visible !important;
}

.top-social .top-social-links{
  display:flex !important;
  visibility:visible !important;
}

.top-social .social-btn{
  visibility:visible !important;
}

/* Mobile */
@media(max-width:600px){
  .top-social{
    display:block !important;
    padding:7px 0 !important;
  }

  .top-social .top-social-inner{
    display:flex !important;
    flex-direction:column !important;
    gap:7px !important;
  }

  .top-social .top-social-links{
    display:grid !important;
    grid-template-columns:repeat(4,1fr);
    width:100%;
    gap:5px;
  }

  .top-social .social-btn{
    min-width:0;
    padding:5px 2px;
    font-size:9px;
  }
}

/* ===== PREMIUM POLISH v1 ===== */

body{
  background:#f8fafc;
  color:#172033;
  -webkit-font-smoothing:antialiased;
}

.wrap{
  width:min(1160px,calc(100% - 32px));
}

header{
  backdrop-filter:blur(14px);
  box-shadow:0 1px 18px rgba(15,23,42,.08);
}

.brand b,
.brand img{
  box-shadow:0 8px 22px rgba(245,158,11,.18);
}

.hero{
  position:relative;
  overflow:hidden;
  padding:72px 0;
}

.hero::before{
  content:"";
  position:absolute;
  width:420px;
  height:420px;
  right:-140px;
  top:-180px;
  border-radius:50%;
  background:rgba(245,158,11,.12);
  filter:blur(10px);
  pointer-events:none;
}

.hero h1{
  letter-spacing:-2px;
}

.hero p{
  max-width:680px;
}

.hero-card{
  backdrop-filter:blur(16px);
  box-shadow:0 25px 70px rgba(0,0,0,.18);
}

.cards a,
.info,
.product,
.cta{
  box-shadow:0 8px 30px rgba(15,23,42,.06);
  transition:transform .2s ease,box-shadow .2s ease;
}

.cards a:hover,
.info:hover,
.product:hover{
  transform:translateY(-4px);
  box-shadow:0 16px 38px rgba(15,23,42,.10);
}

.btn{
  transition:transform .18s ease,box-shadow .18s ease;
}

.btn:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 20px rgba(15,23,42,.12);
}

/* ===== MOBILE PREMIUM ===== */

@media(max-width:600px){

  .wrap{
    width:calc(100% - 24px);
  }

  .nav{
    min-height:58px;
    padding:8px 0;
  }

  .brand{
    gap:7px;
    font-size:12px;
  }

  .brand b,
  .brand img{
    width:34px;
    height:34px;
    border-radius:10px;
  }

  .brand small{
    font-size:7px;
  }

  .nav nav{
    gap:4px;
    font-size:9px;
  }

  .hero{
    padding:42px 0 34px;
  }

  .hero h1{
    font-size:34px;
    line-height:1.08;
    letter-spacing:-1px;
    margin:10px 0 14px;
  }

  .hero p{
    font-size:13px;
    line-height:1.6;
  }

  .actions{
    gap:7px;
    margin:18px 0;
  }

  .btn{
    padding:10px 12px;
    font-size:12px;
    border-radius:10px;
  }

  .stats{
    gap:12px;
  }

  .stats span{
    font-size:9px;
  }

  .hero-card{
    margin-top:8px;
    padding:18px;
    border-radius:17px;
  }

  .hero-card>div{
    font-size:40px;
  }

  .hero-card h2{
    font-size:20px;
  }

  .hero-card p{
    font-size:11px;
  }

  .hero-card li{
    font-size:12px;
    margin:8px 0;
  }

  .section{
    padding:42px 0;
  }

  .section h2{
    font-size:26px;
    letter-spacing:-.5px;
  }

  .cards{
    gap:8px;
  }

  .cards a{
    padding:14px;
    border-radius:14px;
    font-size:20px;
  }

  .cards a b{
    font-size:14px;
  }

  .cards span{
    font-size:9px;
  }

  .cta{
    padding:20px;
    border-radius:17px;
    gap:15px;
  }

  .cta h2{
    font-size:22px;
  }

  footer{
    padding:20px 0;
  }
}


/* ===== PREMIUM HERO ===== */

.premium-hero{
  position:relative;
  overflow:hidden;
  padding:78px 0;
  background:
    radial-gradient(circle at 85% 15%,rgba(245,158,11,.18),transparent 30%),
    linear-gradient(135deg,#07111f 0%,#102a3d 55%,#173b4b 100%);
}

.hero-grid{
  display:grid;
  grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);
  gap:55px;
  align-items:center;
}

.hero-content{
  position:relative;
  z-index:2;
}

.hero-badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:7px 12px;
  border:1px solid rgba(255,255,255,.14);
  border-radius:999px;
  background:rgba(255,255,255,.07);
  color:#fbbf24;
  font-size:11px;
  font-weight:900;
  letter-spacing:1.3px;
}

.hero-badge span{
  color:#22c55e;
  font-size:10px;
}

.premium-hero h1{
  max-width:720px;
  margin:20px 0 16px;
  font-size:clamp(44px,6vw,72px);
  line-height:1.02;
  letter-spacing:-2.5px;
}

.premium-hero h1 em{
  display:block;
  background:linear-gradient(90deg,#fbbf24,#fb923c);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.hero-description{
  max-width:680px;
  margin:0;
  color:#c4d0dc!important;
  font-size:16px!important;
  line-height:1.75!important;
}

.hero-actions{
  margin:25px 0 28px;
}

.hero-trust{
  display:flex;
  gap:30px;
  flex-wrap:wrap;
}

.hero-trust div{
  display:flex;
  flex-direction:column;
  gap:3px;
}

.hero-trust strong{
  color:#fff;
  font-size:15px;
}

.hero-trust span{
  color:#91a2b5;
  font-size:10px;
}

.premium-hero-card{
  position:relative;
  padding:30px;
  border:1px solid rgba(255,255,255,.13);
  border-radius:26px;
  background:linear-gradient(
    145deg,
    rgba(255,255,255,.13),
    rgba(255,255,255,.045)
  );
  box-shadow:0 30px 80px rgba(0,0,0,.28);
  backdrop-filter:blur(18px);
}

.hero-card-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}

.hero-card-icon{
  width:48px;
  height:48px;
  display:grid;
  place-items:center;
  border-radius:15px;
  background:rgba(251,191,36,.14);
  font-size:25px;
}

.hero-card-label{
  color:#fbbf24;
  font-size:9px;
  font-weight:900;
  letter-spacing:1.5px;
}

.premium-hero-card h2{
  margin:22px 0 10px;
  color:#fff;
  font-size:29px;
  line-height:1.12;
}

.premium-hero-card h2 span{
  color:#fbbf24;
}

.premium-hero-card>p{
  margin:0 0 22px;
  color:#b8c6d4;
  font-size:13px;
  line-height:1.65;
}

.hero-feature{
  display:flex;
  align-items:flex-start;
  gap:12px;
  padding:13px 0;
  border-top:1px solid rgba(255,255,255,.09);
}

.hero-feature>span{
  width:24px;
  height:24px;
  flex:none;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#fbbf24;
  color:#111827;
  font-size:12px;
  font-weight:900;
}

.hero-feature strong{
  display:block;
  color:#fff;
  font-size:12px;
}

.hero-feature small{
  display:block;
  margin-top:3px;
  color:#91a2b5;
  font-size:10px;
  line-height:1.4;
}

.hero-card-footer{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-top:18px;
  padding-top:16px;
  border-top:1px solid rgba(255,255,255,.09);
  color:#94a3b8;
  font-size:10px;
}

/* ===== PREMIUM HERO MOBILE ===== */

@media(max-width:850px){

  .premium-hero{
    padding:52px 0 38px;
  }

  .hero-grid{
    grid-template-columns:1fr;
    gap:28px;
  }

  .premium-hero h1{
    font-size:42px;
    letter-spacing:-1.5px;
  }

  .hero-description{
    font-size:14px!important;
  }

}

@media(max-width:600px){

  .premium-hero{
    padding:34px 0 28px;
  }

  .hero-grid{
    gap:20px;
  }

  .hero-badge{
    font-size:9px;
    padding:6px 10px;
  }

  .premium-hero h1{
    font-size:33px;
    line-height:1.06;
    letter-spacing:-1px;
    margin:14px 0;
  }

  .hero-description{
    font-size:12px!important;
    line-height:1.6!important;
  }

  .hero-actions{
    margin:17px 0 20px;
  }

  .hero-trust{
    gap:16px;
  }

  .hero-trust strong{
    font-size:12px;
  }

  .hero-trust span{
    font-size:8px;
  }

  .premium-hero-card{
    padding:19px;
    border-radius:19px;
  }

  .hero-card-icon{
    width:40px;
    height:40px;
    border-radius:12px;
    font-size:21px;
  }

  .premium-hero-card h2{
    font-size:22px;
    margin:16px 0 8px;
  }

  .premium-hero-card>p{
    font-size:11px;
    margin-bottom:14px;
  }

  .hero-feature{
    padding:10px 0;
    gap:9px;
  }

  .hero-feature strong{
    font-size:11px;
  }

  .hero-feature small{
    font-size:9px;
  }

  .hero-card-footer{
    font-size:8px;
    margin-top:12px;
    padding-top:12px;
  }

}


/* ===== PREMIUM CATEGORIES ===== */

.premium-categories{
  background:#ffffff;
}

.section-heading{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:25px;
  margin-bottom:30px;
}

.section-heading h2{
  margin:8px 0 0;
  font-size:42px;
  line-height:1.08;
  letter-spacing:-1.5px;
}

.section-heading h2 em{
  color:#f59e0b;
  font-style:normal;
}

.section-link{
  color:#b45309;
  font-size:13px;
  font-weight:900;
  white-space:nowrap;
}

.premium-category-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
}

.premium-category{
  position:relative;
  min-height:270px;
  overflow:hidden;
  padding:25px;
  border:1px solid #e8edf3;
  border-radius:22px;
  background:#fff;
  box-shadow:0 10px 35px rgba(15,23,42,.055);
  transition:transform .25s ease,box-shadow .25s ease;
}

.premium-category::after{
  content:"";
  position:absolute;
  width:120px;
  height:120px;
  right:-45px;
  bottom:-45px;
  border-radius:50%;
  background:#f59e0b12;
}

.premium-category:hover{
  transform:translateY(-7px);
  box-shadow:0 20px 45px rgba(15,23,42,.11);
}

.category-icon{
  width:52px;
  height:52px;
  display:grid;
  place-items:center;
  border-radius:16px;
  background:#fff7e6;
  font-size:26px;
  margin-bottom:25px;
}

.category-number{
  position:absolute;
  top:25px;
  right:25px;
  color:#cbd5e1;
  font-size:11px;
  font-weight:900;
}

.premium-category h3{
  margin:0 0 8px;
  font-size:21px;
  color:#172033;
}

.premium-category p{
  margin:0;
  color:#64748b;
  font-size:12px;
  line-height:1.65;
  min-height:60px;
}

.premium-category>span{
  display:inline-block;
  margin-top:22px;
  color:#b45309;
  font-size:11px;
  font-weight:900;
}

.hardware .category-icon{
  background:#fff4d6;
}

.construction .category-icon{
  background:#eef6ff;
}

.paint .category-icon{
  background:#fff0f0;
}

.plywood .category-icon{
  background:#f3f7ed;
}

/* ===== CATEGORIES MOBILE ===== */

@media(max-width:850px){

  .premium-category-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .premium-category{
    min-height:240px;
  }

}

@media(max-width:600px){

  .premium-categories{
    padding:38px 0;
  }

  .section-heading{
    align-items:flex-start;
    margin-bottom:20px;
  }

  .section-heading h2{
    font-size:27px;
    letter-spacing:-.7px;
  }

  .section-link{
    font-size:10px;
    padding-top:8px;
  }

  .premium-category-grid{
    gap:9px;
  }

  .premium-category{
    min-height:205px;
    padding:15px;
    border-radius:16px;
  }

  .category-icon{
    width:40px;
    height:40px;
    margin-bottom:17px;
    border-radius:12px;
    font-size:20px;
  }

  .category-number{
    top:15px;
    right:15px;
    font-size:8px;
  }

  .premium-category h3{
    font-size:15px;
    margin-bottom:6px;
  }

  .premium-category p{
    font-size:9px;
    line-height:1.5;
    min-height:48px;
  }

  .premium-category>span{
    margin-top:13px;
    font-size:9px;
  }

}


/* ===== PREMIUM TRUST SECTION ===== */

.premium-trust{
  background:#f7f9fc;
}

.trust-layout{
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:60px;
  align-items:center;
}

.trust-content>small{
  color:#b45309;
  font-size:10px;
  font-weight:900;
  letter-spacing:1.5px;
}

.trust-content h2{
  max-width:620px;
  margin:10px 0 16px;
  color:#172033;
  font-size:45px;
  line-height:1.08;
  letter-spacing:-1.5px;
}

.trust-content h2 em{
  color:#f59e0b;
  font-style:normal;
}

.trust-content>p{
  max-width:600px;
  margin:0;
  color:#64748b;
  font-size:14px;
  line-height:1.8;
}

.trust-points{
  display:grid;
  gap:13px;
  margin-top:28px;
}

.trust-points>div{
  display:flex;
  align-items:flex-start;
  gap:12px;
}

.trust-points>div>span{
  width:25px;
  height:25px;
  flex:none;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#fff3d0;
  color:#b45309;
  font-size:12px;
  font-weight:900;
}

.trust-points strong{
  display:block;
  color:#1e293b;
  font-size:13px;
}

.trust-points small{
  display:block;
  margin-top:2px;
  color:#64748b;
  font-size:10px;
}

.trust-card{
  position:relative;
  overflow:hidden;
  padding:35px;
  border-radius:26px;
  background:
    radial-gradient(circle at 100% 0%,rgba(245,158,11,.22),transparent 35%),
    linear-gradient(145deg,#0a1625,#102b3d);
  color:#fff;
  box-shadow:0 25px 60px rgba(15,23,42,.16);
}

.trust-card::before{
  content:"";
  position:absolute;
  width:180px;
  height:180px;
  right:-80px;
  bottom:-80px;
  border:1px solid rgba(255,255,255,.08);
  border-radius:50%;
}

.trust-card-badge{
  display:inline-block;
  padding:6px 10px;
  border:1px solid rgba(255,255,255,.13);
  border-radius:999px;
  color:#fbbf24;
  background:rgba(255,255,255,.06);
  font-size:9px;
  font-weight:900;
  letter-spacing:1.2px;
}

.trust-big{
  margin-top:25px;
  font-size:75px;
  line-height:.9;
  font-weight:950;
  letter-spacing:-5px;
}

.trust-big span{
  color:#fbbf24;
}

.trust-card h3{
  margin:13px 0 7px;
  font-size:22px;
}

.trust-card>p{
  max-width:330px;
  margin:0;
  color:#aebdca;
  font-size:12px;
  line-height:1.65;
}

.trust-mini-stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-top:27px;
}

.trust-mini-stats>div{
  padding:13px;
  border:1px solid rgba(255,255,255,.09);
  border-radius:13px;
  background:rgba(255,255,255,.045);
}

.trust-mini-stats strong{
  display:block;
  font-size:12px;
}

.trust-mini-stats small{
  display:block;
  margin-top:3px;
  color:#8799aa;
  font-size:9px;
}

/* ===== TRUST MOBILE ===== */

@media(max-width:850px){

  .trust-layout{
    grid-template-columns:1fr;
    gap:30px;
  }

  .trust-content h2{
    font-size:38px;
  }

}

@media(max-width:600px){

  .premium-trust{
    padding:38px 0;
  }

  .trust-layout{
    gap:22px;
  }

  .trust-content h2{
    font-size:28px;
    letter-spacing:-.7px;
    margin:8px 0 12px;
  }

  .trust-content>p{
    font-size:11px;
    line-height:1.65;
  }

  .trust-points{
    gap:10px;
    margin-top:19px;
  }

  .trust-points>div{
    gap:9px;
  }

  .trust-points>div>span{
    width:21px;
    height:21px;
    font-size:9px;
  }

  .trust-points strong{
    font-size:11px;
  }

  .trust-points small{
    font-size:8px;
  }

  .trust-card{
    padding:22px;
    border-radius:19px;
  }

  .trust-big{
    margin-top:18px;
    font-size:55px;
    letter-spacing:-3px;
  }

  .trust-card h3{
    font-size:17px;
    margin:9px 0 5px;
  }

  .trust-card>p{
    font-size:10px;
  }

  .trust-mini-stats{
    margin-top:18px;
  }

  .trust-mini-stats>div{
    padding:10px;
  }

  .trust-mini-stats strong{
    font-size:10px;
  }

  .trust-mini-stats small{
    font-size:8px;
  }

}


/* ==================================================
   PREMIUM HEADER + SOCIAL BAR
   ================================================== */

/* Social strip */
.top-social{
  background:#0b1220 !important;
  border:0 !important;
  box-shadow:none !important;
  padding:8px 0 !important;
  color:#fff;
}

.top-social-inner{
  min-height:32px;
}

.top-social-inner small{
  color:#94a3b8 !important;
  font-size:8px !important;
  letter-spacing:1.4px;
}

.top-social-inner strong{
  color:#fff !important;
  font-size:12px !important;
}

.top-social-links{
  gap:6px !important;
}

.social-btn{
  min-height:30px;
  padding:5px 9px !important;
  border:1px solid rgba(255,255,255,.10) !important;
  border-radius:9px !important;
  background:rgba(255,255,255,.055) !important;
  color:#e5e7eb !important;
  font-size:10px !important;
  transition:.2s ease;
}

.social-btn:hover{
  background:rgba(255,255,255,.11) !important;
  border-color:rgba(255,255,255,.2) !important;
  transform:translateY(-1px);
}

.social-icon{
  width:22px !important;
  height:22px !important;
  font-size:11px !important;
}

/* Main navigation */
header{
  background:#0b1220 !important;
  border-top:1px solid rgba(255,255,255,.06);
  border-bottom:1px solid rgba(255,255,255,.08);
  box-shadow:0 8px 25px rgba(0,0,0,.16);
}

.nav{
  min-height:76px !important;
}

.brand{
  font-size:15px !important;
}

.brand b,
.brand img{
  width:44px !important;
  height:44px !important;
}

.brand small{
  color:#94a3b8 !important;
  font-size:9px !important;
}

.nav nav{
  align-items:center;
  gap:7px !important;
  font-size:14px !important;
}

.nav nav a{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:40px;
  padding:0 12px;
  border-radius:10px;
  color:#cbd5e1;
  font-weight:750;
  transition:.2s ease;
}

.nav nav a:hover{
  color:#fff;
  background:rgba(255,255,255,.07);
}

.nav nav a.active{
  color:#111827 !important;
  background:linear-gradient(135deg,#ffca3a,#f59e0b);
  box-shadow:0 5px 18px rgba(245,158,11,.20);
}

/* Admin button */
.nav nav a:last-child{
  color:#fbbf24;
  border:1px solid rgba(251,191,36,.22);
  background:rgba(251,191,36,.06);
}

.nav nav a:last-child:hover{
  background:rgba(251,191,36,.13);
}

/* ==================================================
   MOBILE HEADER
   ================================================== */

@media(max-width:600px){

  .top-social{
    padding:6px 0 !important;
  }

  .top-social-inner{
    min-height:auto;
    gap:6px !important;
  }

  .top-social-title{
    width:100%;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }

  .top-social-title strong{
    font-size:10px !important;
  }

  .top-social-links{
    display:flex !important;
    width:100%;
    overflow-x:auto;
    flex-wrap:nowrap !important;
    gap:5px !important;
    padding-bottom:2px;
    scrollbar-width:none;
  }

  .top-social-links::-webkit-scrollbar{
    display:none;
  }

  .social-btn{
    flex:0 0 auto !important;
    min-width:auto !important;
    padding:5px 8px !important;
    border-radius:8px !important;
    font-size:9px !important;
  }

  .social-icon{
    width:20px !important;
    height:20px !important;
  }

  header{
    position:sticky;
    top:0;
  }

  .nav{
    min-height:64px !important;
    padding:8px 0 !important;
    align-items:center !important;
    gap:7px !important;
  }

  .brand{
    flex:0 0 auto;
    gap:6px !important;
    font-size:12px !important;
  }

  .brand b,
  .brand img{
    width:36px !important;
    height:36px !important;
    border-radius:10px;
  }

  .brand small{
    font-size:7px !important;
  }

  .nav nav{
    flex:1;
    display:flex;
    justify-content:flex-end;
    flex-wrap:nowrap !important;
    overflow-x:auto;
    gap:4px !important;
    scrollbar-width:none;
  }

  .nav nav::-webkit-scrollbar{
    display:none;
  }

  .nav nav a{
    flex:0 0 auto;
    min-height:34px;
    padding:0 9px;
    border-radius:8px;
    font-size:11px !important;
    white-space:nowrap;
  }

  .nav nav a:last-child{
    padding:0 8px;
  }

}

/* Extra small phones */
@media(max-width:390px){

  .brand span{
    max-width:92px;
    overflow:hidden;
    white-space:nowrap;
  }

  .nav nav a{
    font-size:10px !important;
    padding:0 8px;
  }

}


/* ==================================================
   HEADER FINAL — BRAND TOP / NAV BELOW
   ================================================== */

@media(max-width:600px){

  header{
    position:sticky;
    top:0;
    z-index:20;
  }

  .nav{
    display:grid !important;
    grid-template-columns:1fr !important;
    gap:8px !important;
    padding:10px 0 9px !important;
  }

  /* Brand becomes the main title */
  .brand{
    width:100%;
    justify-content:flex-start;
    gap:9px !important;
    font-size:15px !important;
  }

  .brand b,
  .brand img{
    width:40px !important;
    height:40px !important;
    border-radius:11px !important;
  }

  .brand span{
    font-size:14px !important;
    line-height:1.1;
    max-width:none !important;
    overflow:visible !important;
    white-space:normal !important;
  }

  .brand small{
    margin-top:3px;
    font-size:8px !important;
  }

  /* Navigation gets its own row */
  .nav nav{
    width:100%;
    display:flex !important;
    justify-content:flex-start !important;
    align-items:center;
    overflow-x:auto;
    gap:6px !important;
    padding:2px 0 1px;
    scrollbar-width:none;
  }

  .nav nav::-webkit-scrollbar{
    display:none;
  }

  .nav nav a{
    flex:0 0 auto !important;
    min-height:36px !important;
    padding:0 12px !important;
    border-radius:9px !important;
    font-size:12px !important;
    font-weight:800 !important;
    white-space:nowrap;
  }

  .nav nav a.active{
    padding-left:14px !important;
    padding-right:14px !important;
  }

  .nav nav a:last-child{
    padding-left:11px !important;
    padding-right:11px !important;
  }

}

/* ==================================================
   SOCIAL BUTTONS — CLEANER ICON STYLE
   ================================================== */

.social-btn{
  gap:6px !important;
}

.social-btn .social-icon{
  box-shadow:0 2px 7px rgba(0,0,0,.15);
}


/* ===== INSTAGRAM PROFESSIONAL ICON ===== */

.instagram-icon{
  width:28px !important;
  height:28px !important;
  border-radius:8px !important;
  display:grid !important;
  place-items:center !important;
  background:linear-gradient(135deg,#833ab4 0%,#fd1d1d 52%,#fcb045 100%) !important;
  position:relative;
  box-shadow:0 3px 9px rgba(131,58,180,.28);
}

.instagram-camera{
  width:15px;
  height:15px;
  border:2px solid #fff;
  border-radius:5px;
  position:relative;
  display:block;
}

.instagram-camera::before{
  content:"";
  position:absolute;
  width:5px;
  height:5px;
  border:2px solid #fff;
  border-radius:50%;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
}

.instagram-camera::after{
  content:"";
  position:absolute;
  width:3px;
  height:3px;
  background:#fff;
  border-radius:50%;
  right:1px;
  top:1px;
}


/* =====================================================
   PREMIUM VISIT US SECTION
   ===================================================== */

.visit-card{
  position:relative;
  overflow:hidden;
  display:grid;
  grid-template-columns:minmax(0,1.55fr) minmax(280px,.75fr);
  gap:0;
  background:
    radial-gradient(circle at 85% 15%,rgba(245,158,11,.16),transparent 30%),
    linear-gradient(135deg,#0a1422,#12283a);
  border:1px solid rgba(255,255,255,.08);
  border-radius:30px;
  box-shadow:0 22px 55px rgba(8,17,31,.16);
  color:#fff;
  isolation:isolate;
}

.visit-card::before{
  content:"";
  position:absolute;
  width:330px;
  height:330px;
  right:-150px;
  bottom:-180px;
  border-radius:50%;
  background:rgba(245,158,11,.09);
  z-index:-1;
}

.visit-main{
  padding:42px 44px;
}

.visit-badge{
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:8px 13px;
  border-radius:999px;
  background:rgba(245,158,11,.12);
  border:1px solid rgba(245,158,11,.25);
  color:#fbbf24;
  font-size:11px;
  font-weight:900;
  letter-spacing:1.3px;
}

.visit-main h2{
  margin:18px 0 14px;
  max-width:620px;
  font-size:clamp(30px,4vw,48px);
  line-height:1.08;
  letter-spacing:-1px;
}

.visit-main h2 em{
  color:#fbbf24;
  font-style:normal;
}

.visit-main p{
  max-width:650px;
  margin:0;
  color:#b8c6d6;
  font-size:15px;
  line-height:1.75;
}

.visit-actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:25px;
}

.visit-actions .btn{
  min-height:46px;
  padding:12px 17px;
}

.visit-actions .light{
  background:#fff;
  color:#111827;
  border:1px solid #fff;
}

.visit-actions .outline{
  color:#fff;
  border-color:rgba(255,255,255,.25);
  background:rgba(255,255,255,.04);
}

.visit-actions .outline:hover{
  background:rgba(255,255,255,.1);
}

.visit-side{
  display:grid;
  align-content:center;
  gap:0;
  padding:34px;
  background:rgba(255,255,255,.045);
  border-left:1px solid rgba(255,255,255,.08);
}

.visit-side > div{
  padding:19px 0;
  border-bottom:1px solid rgba(255,255,255,.09);
}

.visit-side > div:last-child{
  border-bottom:0;
}

.visit-side small{
  display:block;
  margin-bottom:7px;
  color:#91a4b8;
  font-size:10px;
  font-weight:900;
  letter-spacing:1.4px;
}

.visit-side strong{
  display:block;
  color:#fff;
  font-size:17px;
  line-height:1.35;
}

.visit-side > div:last-child strong{
  color:#fbbf24;
  font-size:22px;
}

/* Mobile */
@media(max-width:850px){

  .visit-card{
    grid-template-columns:1fr;
    border-radius:24px;
  }

  .visit-main{
    padding:30px 24px;
  }

  .visit-main h2{
    font-size:32px;
    letter-spacing:-.5px;
  }

  .visit-main p{
    font-size:14px;
    line-height:1.7;
  }

  .visit-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
  }

  .visit-actions .btn{
    width:100%;
  }

  .visit-actions .btn:last-child{
    grid-column:1/-1;
  }

  .visit-side{
    grid-template-columns:repeat(3,1fr);
    padding:20px;
    border-left:0;
    border-top:1px solid rgba(255,255,255,.08);
  }

  .visit-side > div{
    padding:10px 14px;
    border-bottom:0;
    border-right:1px solid rgba(255,255,255,.09);
  }

  .visit-side > div:last-child{
    border-right:0;
  }

  .visit-side strong{
    font-size:14px;
  }

  .visit-side > div:last-child strong{
    font-size:17px;
  }
}

@media(max-width:520px){

  .visit-main{
    padding:26px 20px;
  }

  .visit-badge{
    font-size:9px;
    letter-spacing:1px;
  }

  .visit-main h2{
    font-size:28px;
    line-height:1.12;
  }

  .visit-actions{
    grid-template-columns:1fr;
  }

  .visit-actions .btn:last-child{
    grid-column:auto;
  }

  .visit-side{
    grid-template-columns:1fr;
    gap:0;
    padding:8px 20px 18px;
  }

  .visit-side > div{
    padding:14px 0;
    border-right:0;
    border-bottom:1px solid rgba(255,255,255,.09);
  }

  .visit-side > div:last-child{
    border-bottom:0;
  }

}


/* =====================================================
   PREMIUM PRODUCTS PAGE
   ===================================================== */

.pagehero{
  position:relative;
  overflow:hidden;
  padding:72px 0 58px;
  background:
    radial-gradient(circle at 85% 20%,rgba(245,158,11,.14),transparent 32%),
    linear-gradient(135deg,#08121f,#102536);
  color:#fff;
}

.pagehero::after{
  content:"";
  position:absolute;
  width:260px;
  height:260px;
  right:-110px;
  bottom:-150px;
  border-radius:50%;
  background:rgba(245,158,11,.08);
}

.pagehero small{
  color:#fbbf24;
  font-weight:900;
  letter-spacing:1.5px;
}

.pagehero h1{
  margin:12px 0 10px;
  font-size:clamp(36px,5vw,58px);
  letter-spacing:-1.5px;
}

.pagehero p{
  margin:0;
  color:#aebdcd;
  font-size:15px;
}

/* SEARCH AREA */

.filters{
  display:grid;
  grid-template-columns:minmax(0,1fr) 230px;
  gap:14px;
  margin-bottom:30px;
  padding:16px;
  background:#fff;
  border:1px solid #e7edf3;
  border-radius:20px;
  box-shadow:0 12px 35px rgba(15,23,42,.07);
}

.filters input,
.filters select{
  min-height:52px;
  border:1px solid #dbe3eb;
  border-radius:13px;
  padding:0 16px;
  background:#f8fafc;
  color:#172033;
  font:inherit;
  outline:none;
  transition:.2s ease;
}

.filters input:focus,
.filters select:focus{
  background:#fff;
  border-color:#f59e0b;
  box-shadow:0 0 0 4px rgba(245,158,11,.12);
}

/* PRODUCT GRID */

.product-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:20px;
}

.product{
  overflow:hidden;
  display:flex;
  flex-direction:column;
  min-width:0;
  background:#fff;
  border:1px solid #e6ebf1;
  border-radius:22px;
  box-shadow:0 10px 30px rgba(15,23,42,.07);
  transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease;
}

.product:hover{
  transform:translateY(-5px);
  border-color:#f2c15a;
  box-shadow:0 18px 40px rgba(15,23,42,.12);
}

.product .pic{
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
  height:210px;
  overflow:hidden;
  background:
    radial-gradient(circle at 50% 30%,#fff,#f2f5f8);
  color:#94a3b8;
  font-size:48px;
}

.product .pic::after{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(to top,rgba(15,23,42,.05),transparent 35%);
}

.product .pic img{
  width:100%;
  height:100%;
  object-fit:contain;
  padding:18px;
  transition:transform .3s ease;
}

.product:hover .pic img{
  transform:scale(1.05);
}

.product .pbody{
  display:flex;
  flex-direction:column;
  flex:1;
  padding:19px;
}

.product .pbody small{
  color:#f59e0b;
  font-size:10px;
  font-weight:900;
  letter-spacing:1.1px;
  text-transform:uppercase;
}

.product .pbody h3{
  margin:7px 0 5px;
  color:#142033;
  font-size:18px;
  line-height:1.25;
}

.product .pbody p{
  color:#64748b;
  font-size:13px;
  line-height:1.55;
}

.product .price{
  margin-top:auto;
  color:#101827;
  font-size:22px;
  font-weight:900;
}

.product .unit{
  color:#94a3b8;
  font-size:12px;
}

/* CART */

.cart-area{
  background:#f5f7fa;
}

.cart{
  overflow:hidden;
  background:#fff;
  border:1px solid #e4eaf0;
  border-radius:25px;
  box-shadow:0 16px 45px rgba(15,23,42,.08);
}

.cart .head{
  padding:25px 28px;
  border-bottom:1px solid #edf1f5;
}

.cart .head h2{
  margin:5px 0 0;
}

#cartItems{
  min-height:60px;
  padding:10px 28px;
}

#cartItems:empty::before{
  content:"Aapki shopping list abhi empty hai.";
  display:block;
  padding:22px 0;
  color:#94a3b8;
  text-align:center;
  font-size:14px;
}

.cart .total{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:20px 28px;
  border-top:1px solid #edf1f5;
  background:#fafbfc;
}

.cart .total span{
  color:#64748b;
  font-weight:700;
}

.cart .total b{
  color:#101827;
  font-size:25px;
}

.cart > .btn{
  margin:0 28px 28px;
  width:calc(100% - 56px);
  min-height:52px;
}

/* RESPONSIVE */

@media(max-width:1050px){
  .product-grid{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }
}

@media(max-width:760px){

  .pagehero{
    padding:54px 0 44px;
  }

  .pagehero h1{
    font-size:40px;
  }

  .filters{
    grid-template-columns:1fr;
    padding:12px;
  }

  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:14px;
  }

  .product .pic{
    height:175px;
  }

  .product .pbody{
    padding:15px;
  }

  .product .pbody h3{
    font-size:16px;
  }

}

@media(max-width:480px){

  .pagehero{
    padding:44px 0 36px;
  }

  .pagehero h1{
    font-size:34px;
  }

  .product-grid{
    grid-template-columns:1fr;
  }

  .product .pic{
    height:220px;
  }

  .cart .head,
  #cartItems,
  .cart .total{
    padding-left:20px;
    padding-right:20px;
  }

  .cart > .btn{
    margin-left:20px;
    margin-right:20px;
    width:calc(100% - 40px);
  }

}


/* ===== COMPACT PRODUCT GRID ===== */

.product-grid{
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:16px;
}

.product{
  border-radius:18px;
}

.product .pic{
  height:175px;
}

.product .pic img{
  padding:14px;
}

.product .pbody{
  padding:15px;
}

.product .pbody h3{
  font-size:16px;
}

.product .pbody p{
  font-size:12px;
}

.product .price{
  font-size:19px;
}

@media(max-width:900px){
  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .product .pic{
    height:165px;
  }
}

@media(max-width:480px){
  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:10px;
  }

  .product{
    border-radius:15px;
  }

  .product .pic{
    height:145px;
  }

  .product .pic img{
    padding:9px;
  }

  .product .pbody{
    padding:12px;
  }

  .product .pbody h3{
    font-size:14px;
  }

  .product .pbody small{
    font-size:9px;
  }

  .product .price{
    font-size:17px;
  }
}


/* ===== PRODUCTS V2 — CLEAN COMPACT PREMIUM ===== */

.product-grid{
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px;
}

.product{
  position:relative;
  border-radius:20px;
  background:#fff;
  border:1px solid #e5eaf0;
  box-shadow:0 7px 22px rgba(15,23,42,.06);
}

.product:hover{
  transform:translateY(-3px);
  box-shadow:0 14px 30px rgba(15,23,42,.10);
}

.product .pic{
  height:165px;
  background:#f7f9fb;
}

.product .pic img{
  padding:12px;
}

.product .pbody{
  padding:14px 15px 16px;
}

.product .pbody small{
  font-size:9px;
  letter-spacing:1px;
}

.product .pbody h3{
  margin:6px 0 4px;
  font-size:16px;
  line-height:1.25;
}

.product .pbody p{
  margin:4px 0 10px;
  font-size:12px;
  line-height:1.45;
}

.product .price{
  font-size:19px;
  line-height:1;
}

.product .unit{
  font-size:11px;
}

/* TABLET */

@media(max-width:900px){

  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:15px;
  }

  .product .pic{
    height:170px;
  }
}

/* MOBILE */

@media(max-width:520px){

  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:11px;
  }

  .product{
    border-radius:16px;
  }

  .product .pic{
    height:135px;
  }

  .product .pic img{
    padding:8px;
  }

  .product .pbody{
    padding:11px;
  }

  .product .pbody h3{
    font-size:14px;
    line-height:1.2;
  }

  .product .pbody small{
    font-size:8px;
  }

  .product .pbody p{
    font-size:11px;
    margin-bottom:8px;
  }

  .product .price{
    font-size:16px;
  }

  .product .unit{
    font-size:10px;
  }
}


/* ===== PRODUCTS — FINAL COMPACT ===== */

.product-grid{
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:13px;
}

.product{
  border-radius:15px;
}

.product .pic{
  height:125px;
}

.product .pic img{
  padding:8px;
}

.product .pbody{
  padding:11px 12px 12px;
}

.product .pbody small{
  font-size:8px;
  letter-spacing:.8px;
}

.product .pbody h3{
  margin:5px 0 3px;
  font-size:14px;
  line-height:1.2;
}

.product .pbody p{
  margin:3px 0 7px;
  font-size:10px;
  line-height:1.35;
}

.product .price{
  font-size:16px;
}

.product .unit{
  font-size:10px;
}

@media(max-width:1000px){
  .product-grid{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }
}

@media(max-width:700px){
  .product-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:9px;
  }

  .product .pic{
    height:115px;
  }

  .product .pbody{
    padding:9px 10px 10px;
  }
}

@media(max-width:400px){
  .product-grid{
    gap:7px;
  }

  .product .pic{
    height:105px;
  }

  .product .pbody h3{
    font-size:13px;
  }

  .product .price{
    font-size:15px;
  }
}


/* ===== PRODUCTS PAGE — COMPACT HERO ===== */

.pagehero{
  padding:38px 0 32px;
}

.pagehero h1{
  margin:6px 0 5px;
  font-size:34px;
  letter-spacing:-.8px;
}

.pagehero p{
  font-size:13px;
}

.pagehero small{
  font-size:9px;
  letter-spacing:1.2px;
}

@media(max-width:600px){

  .pagehero{
    padding:28px 0 24px;
  }

  .pagehero h1{
    font-size:27px;
    margin:5px 0 4px;
  }

  .pagehero p{
    font-size:11px;
  }

}


/* ===== PRODUCTS FILTERS — SINGLE LINE ===== */

.filters{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px;
  margin-bottom:22px;
}

.filters input{
  flex:1;
  min-width:0;
  height:44px;
}

.filters select{
  width:190px;
  min-width:150px;
  height:44px;
}

@media(max-width:520px){

  .filters{
    display:flex;
    gap:7px;
    padding:8px;
  }

  .filters input{
    width:auto;
    flex:1;
    height:40px;
    padding:0 11px;
    font-size:12px;
  }

  .filters select{
    width:125px;
    min-width:125px;
    height:40px;
    padding:0 8px;
    font-size:11px;
  }

}


/* ===== PREMIUM COMPACT SHOPPING CART ===== */

.cart{
  border-radius:20px;
  box-shadow:0 10px 30px rgba(15,23,42,.07);
}

.cart .head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:18px 22px;
}

.cart .head small{
  font-size:9px;
  letter-spacing:1.2px;
  font-weight:900;
  color:#f59e0b;
}

.cart .head h2{
  margin:4px 0 0;
  font-size:22px;
}

.cart .head #clear{
  min-height:38px;
  padding:0 16px;
  font-size:12px;
  border-radius:10px;
}

#cartItems{
  min-height:70px;
  padding:0 22px;
}

#cartItems:empty::before{
  content:"🛒  Your list is empty. Products add karo aur yahan dikhenge.";
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:70px;
  padding:0;
  color:#94a3b8;
  font-size:13px;
  text-align:center;
}

.cart .total{
  padding:15px 22px;
  margin-top:0;
}

.cart .total span{
  font-size:13px;
  font-weight:700;
}

.cart .total b{
  font-size:21px;
}

.cart > #whatsapp{
  margin:14px 22px 20px;
  width:calc(100% - 44px);
  min-height:46px;
  border-radius:11px;
  font-size:13px;
  font-weight:800;
}

/* CART ITEMS */

#cartItems .cart-item{
  padding:12px 0;
  border-bottom:1px solid #edf1f5;
}

@media(max-width:520px){

  .cart{
    border-radius:17px;
  }

  .cart .head{
    padding:15px 16px;
  }

  .cart .head h2{
    font-size:19px;
  }

  #cartItems{
    padding:0 16px;
  }

  #cartItems:empty::before{
    font-size:11px;
    min-height:62px;
  }

  .cart .total{
    padding:13px 16px;
  }

  .cart > #whatsapp{
    margin:12px 16px 16px;
    width:calc(100% - 32px);
  }

}


/* ===== BEAUTIFUL SHOPPING LIST ===== */

.cart{
  position:relative;
  overflow:hidden;
  border:1px solid #e6ebf1;
  border-radius:22px;
  background:#fff;
  box-shadow:0 12px 35px rgba(15,23,42,.08);
}

.cart::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:3px;
  background:linear-gradient(90deg,#f59e0b,#fbbf24,#f59e0b);
}

.cart .head{
  padding:20px 24px;
  background:linear-gradient(135deg,#fff,#f8fafc);
  border-bottom:1px solid #edf1f5;
}

.cart .head > div{
  display:flex;
  align-items:center;
  gap:10px;
}

.cart .head > div::before{
  content:"🛒";
  display:flex;
  align-items:center;
  justify-content:center;
  width:38px;
  height:38px;
  border-radius:12px;
  background:#fff7df;
  font-size:18px;
}

.cart .head small{
  display:block;
  color:#f59e0b;
  font-size:9px;
  font-weight:900;
  letter-spacing:1.4px;
}

.cart .head h2{
  margin:3px 0 0;
  font-size:21px;
  color:#162033;
}

.cart .head #clear{
  min-height:36px;
  padding:0 14px;
  border-radius:10px;
  font-size:11px;
  font-weight:800;
}

#cartItems{
  padding:8px 24px;
}

#cartItems:empty::before{
  content:"🛍️  Your list is empty";
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:72px;
  color:#64748b;
  font-size:13px;
  font-weight:600;
  letter-spacing:.1px;
}

.cart .total{
  margin:8px 14px 0;
  padding:14px 18px;
  border:1px solid #edf1f5;
  border-radius:14px;
  background:#f8fafc;
}

.cart .total span{
  color:#64748b;
  font-size:13px;
  font-weight:700;
}

.cart .total b{
  color:#101827;
  font-size:22px;
}

.cart > #whatsapp{
  margin:14px 24px 22px;
  width:calc(100% - 48px);
  min-height:48px;
  border:0;
  border-radius:13px;
  font-size:13px;
  font-weight:900;
  box-shadow:0 7px 18px rgba(16,185,129,.16);
  transition:.2s ease;
}

.cart > #whatsapp:hover{
  transform:translateY(-2px);
}

@media(max-width:520px){

  .cart{
    border-radius:18px;
  }

  .cart .head{
    padding:16px;
  }

  .cart .head > div::before{
    width:34px;
    height:34px;
    font-size:16px;
  }

  .cart .head h2{
    font-size:18px;
  }

  #cartItems{
    padding:6px 16px;
  }

  #cartItems:empty::before{
    min-height:58px;
    font-size:11px;
  }

  .cart .total{
    margin:7px 10px 0;
    padding:12px 14px;
  }

  .cart .total b{
    font-size:19px;
  }

  .cart > #whatsapp{
    margin:12px 16px 17px;
    width:calc(100% - 32px);
    min-height:45px;
  }

}


/* ===== SHOPPING CART — BALANCED PREMIUM ===== */

.cart{
  position:relative;
  overflow:hidden;
  max-width:980px;
  margin:0 auto;
  border:1px solid #e3e8ef;
  border-radius:24px;
  background:#fff;
  box-shadow:0 15px 45px rgba(15,23,42,.09);
}

.cart::before{
  content:"";
  position:absolute;
  inset:0 0 auto 0;
  height:4px;
  background:linear-gradient(90deg,#f59e0b,#fbbf24,#f59e0b);
}

.cart .head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:25px 28px;
  background:linear-gradient(135deg,#fffdf7,#f8fafc);
  border-bottom:1px solid #edf1f5;
}

.cart .head > div{
  display:flex;
  align-items:center;
  gap:13px;
}

.cart .head > div::before{
  content:"🛒";
  display:flex;
  align-items:center;
  justify-content:center;
  width:48px;
  height:48px;
  border-radius:15px;
  background:linear-gradient(135deg,#fff4cf,#fffbeb);
  border:1px solid #fde7a5;
  font-size:23px;
  box-shadow:0 5px 15px rgba(245,158,11,.12);
}

.cart .head small{
  display:block;
  margin-bottom:4px;
  color:#d88900;
  font-size:10px;
  font-weight:900;
  letter-spacing:1.6px;
}

.cart .head h2{
  margin:0;
  color:#172033;
  font-size:25px;
  line-height:1.1;
}

.cart .head #clear{
  min-height:40px;
  padding:0 18px;
  border-radius:11px;
  font-size:12px;
  font-weight:800;
}

#cartItems{
  padding:16px 28px;
  min-height:105px;
}

#cartItems:empty::before{
  content:"🛍️  Your list is empty";
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:85px;
  border:1px dashed #d9e0e8;
  border-radius:16px;
  background:#fafbfd;
  color:#7b8798;
  font-size:14px;
  font-weight:600;
}

.cart .total{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:4px 28px 0;
  padding:18px 20px;
  border-radius:16px;
  background:#f7f9fc;
  border:1px solid #e9eef4;
}

.cart .total span{
  color:#596579;
  font-size:14px;
  font-weight:700;
}

.cart .total b{
  color:#111827;
  font-size:25px;
  font-weight:900;
}

.cart > #whatsapp{
  display:flex;
  align-items:center;
  justify-content:center;
  margin:18px 28px 28px;
  width:calc(100% - 56px);
  min-height:52px;
  border:0;
  border-radius:14px;
  font-size:14px;
  font-weight:900;
  letter-spacing:.1px;
  box-shadow:0 8px 20px rgba(16,185,129,.18);
  transition:transform .2s ease,box-shadow .2s ease;
}

.cart > #whatsapp:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 25px rgba(16,185,129,.24);
}

/* Mobile */

@media(max-width:520px){

  .cart{
    border-radius:20px;
  }

  .cart .head{
    padding:20px 17px;
  }

  .cart .head > div{
    gap:10px;
  }

  .cart .head > div::before{
    width:42px;
    height:42px;
    border-radius:13px;
    font-size:20px;
  }

  .cart .head small{
    font-size:9px;
  }

  .cart .head h2{
    font-size:20px;
  }

  .cart .head #clear{
    min-height:36px;
    padding:0 13px;
  }

  #cartItems{
    padding:13px 17px;
    min-height:95px;
  }

  #cartItems:empty::before{
    min-height:72px;
    font-size:12px;
  }

  .cart .total{
    margin:3px 17px 0;
    padding:15px 16px;
  }

  .cart .total b{
    font-size:21px;
  }

  .cart > #whatsapp{
    margin:15px 17px 20px;
    width:calc(100% - 34px);
    min-height:48px;
    font-size:13px;
  }

}


/* ===== SHOPPING CART — FULL COLOR PREMIUM ===== */

.cart{
  position:relative;
  overflow:hidden;
  max-width:980px;
  margin:0 auto;
  border:0;
  border-radius:26px;
  background:linear-gradient(145deg,#ffffff 0%,#fffaf0 45%,#f4f8ff 100%);
  box-shadow:0 18px 50px rgba(15,23,42,.13);
}

/* colorful top glow */
.cart::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:6px;
  background:linear-gradient(
    90deg,
    #f59e0b,
    #f97316,
    #ef4444,
    #8b5cf6,
    #2563eb,
    #10b981
  );
}

/* soft background decoration */
.cart::after{
  content:"";
  position:absolute;
  width:220px;
  height:220px;
  right:-90px;
  top:-100px;
  border-radius:50%;
  background:rgba(251,191,36,.14);
  pointer-events:none;
}

.cart .head{
  position:relative;
  z-index:1;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:28px 30px;
  background:linear-gradient(
    135deg,
    #fff7df 0%,
    #fff 48%,
    #eef5ff 100%
  );
  border-bottom:1px solid rgba(226,232,240,.8);
}

.cart .head > div{
  display:flex;
  align-items:center;
  gap:14px;
}

.cart .head > div::before{
  content:"🛒";
  display:flex;
  align-items:center;
  justify-content:center;
  width:52px;
  height:52px;
  border-radius:17px;
  background:linear-gradient(135deg,#f59e0b,#f97316);
  border:3px solid #fff;
  font-size:25px;
  box-shadow:0 8px 20px rgba(249,115,22,.25);
}

.cart .head small{
  display:block;
  margin-bottom:5px;
  color:#ea580c;
  font-size:10px;
  font-weight:900;
  letter-spacing:1.8px;
}

.cart .head h2{
  margin:0;
  color:#172033;
  font-size:27px;
  line-height:1.1;
  font-weight:900;
}

.cart .head #clear{
  min-height:42px;
  padding:0 18px;
  border-radius:12px;
  border:1px solid #fecaca;
  background:#fff;
  color:#dc2626;
  font-size:12px;
  font-weight:900;
  transition:.2s ease;
}

.cart .head #clear:hover{
  background:#fee2e2;
  transform:translateY(-2px);
}

/* empty cart */

#cartItems{
  position:relative;
  z-index:1;
  padding:18px 30px;
  min-height:125px;
}

#cartItems:empty::before{
  content:"🛍️  Your list is empty";
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:92px;
  border:2px dashed #f3d28a;
  border-radius:18px;
  background:linear-gradient(135deg,#fffdf5,#fff8e7);
  color:#9a6b16;
  font-size:14px;
  font-weight:800;
}

/* total */

.cart .total{
  position:relative;
  z-index:1;
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:5px 30px 0;
  padding:19px 22px;
  border-radius:17px;
  background:linear-gradient(135deg,#172033,#263957);
  border:1px solid #334968;
  box-shadow:0 8px 20px rgba(15,23,42,.12);
}

.cart .total span{
  color:#cbd5e1;
  font-size:14px;
  font-weight:800;
}

.cart .total b{
  color:#fbbf24;
  font-size:26px;
  font-weight:900;
}

/* whatsapp */

.cart > #whatsapp{
  position:relative;
  z-index:1;
  display:flex;
  align-items:center;
  justify-content:center;
  margin:18px 30px 30px;
  width:calc(100% - 60px);
  min-height:54px;
  border:0;
  border-radius:15px;
  background:linear-gradient(135deg,#16a34a,#059669);
  color:#fff;
  font-size:14px;
  font-weight:900;
  box-shadow:0 10px 25px rgba(5,150,105,.25);
  transition:.2s ease;
}

.cart > #whatsapp:hover{
  transform:translateY(-3px);
  box-shadow:0 15px 30px rgba(5,150,105,.32);
}

/* cart items when products are added */

#cartItems .cart-item{
  background:#fff;
  border:1px solid #e8edf3;
  border-left:4px solid #f59e0b;
  border-radius:13px;
  margin:8px 0;
  padding:13px 15px;
  box-shadow:0 4px 12px rgba(15,23,42,.05);
}

/* mobile */

@media(max-width:520px){

  .cart{
    border-radius:21px;
  }

  .cart .head{
    padding:21px 17px;
  }

  .cart .head > div{
    gap:10px;
  }

  .cart .head > div::before{
    width:43px;
    height:43px;
    border-radius:14px;
    font-size:20px;
  }

  .cart .head small{
    font-size:8px;
  }

  .cart .head h2{
    font-size:20px;
  }

  .cart .head #clear{
    min-height:36px;
    padding:0 12px;
    font-size:10px;
  }

  #cartItems{
    padding:13px 17px;
    min-height:105px;
  }

  #cartItems:empty::before{
    min-height:72px;
    font-size:11px;
  }

  .cart .total{
    margin:3px 17px 0;
    padding:15px 16px;
  }

  .cart .total span{
    font-size:12px;
  }

  .cart .total b{
    font-size:21px;
  }

  .cart > #whatsapp{
    margin:14px 17px 20px;
    width:calc(100% - 34px);
    min-height:48px;
    font-size:12px;
  }

}


/* =====================================================
   SHOPPING CART — HOME PAGE THEME
   ===================================================== */

.cart{
  position:relative;
  overflow:hidden;
  max-width:980px;
  margin:0 auto;
  border:1px solid rgba(20,32,51,.10);
  border-radius:24px;
  background:linear-gradient(145deg,#ffffff 0%,#fffdf8 100%);
  box-shadow:0 16px 42px rgba(15,23,42,.10);
}

.cart::before{
  content:"";
  position:absolute;
  inset:0 0 auto;
  height:4px;
  background:linear-gradient(90deg,#d99a16,#f4c65d,#d99a16);
}

.cart::after{
  content:"";
  position:absolute;
  width:240px;
  height:240px;
  right:-130px;
  top:-130px;
  border-radius:50%;
  background:rgba(217,154,22,.07);
  pointer-events:none;
}

.cart .head{
  position:relative;
  z-index:1;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:26px 28px;
  background:linear-gradient(135deg,#fffaf0,#ffffff);
  border-bottom:1px solid rgba(20,32,51,.08);
}

.cart .head > div{
  display:flex;
  align-items:center;
  gap:13px;
}

.cart .head > div::before{
  content:"🛒";
  display:flex;
  align-items:center;
  justify-content:center;
  width:48px;
  height:48px;
  border-radius:14px;
  background:#172033;
  color:#f4c65d;
  font-size:22px;
  box-shadow:0 8px 18px rgba(15,23,42,.15);
}

.cart .head small{
  display:block;
  color:#b7790b;
  font-size:9px;
  font-weight:900;
  letter-spacing:1.6px;
}

.cart .head h2{
  margin:4px 0 0;
  color:#172033;
  font-size:25px;
  font-weight:900;
}

.cart .head #clear{
  min-height:39px;
  padding:0 16px;
  border-radius:10px;
  font-size:11px;
  font-weight:800;
}

/* Empty state */

#cartItems{
  position:relative;
  z-index:1;
  padding:18px 28px;
  min-height:110px;
}

#cartItems:empty::before{
  content:"🛍️  Your list is empty";
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:78px;
  border:1px dashed rgba(183,121,11,.28);
  border-radius:15px;
  background:#fffaf0;
  color:#7b6a4b;
  font-size:13px;
  font-weight:600;
}

/* Cart items */

#cartItems .cart-item{
  background:#fff;
  border:1px solid #e8edf2;
  border-left:3px solid #d99a16;
  border-radius:13px;
  margin:8px 0;
  padding:13px 15px;
  box-shadow:0 5px 16px rgba(15,23,42,.05);
}

/* Total */

.cart .total{
  position:relative;
  z-index:1;
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:4px 28px 0;
  padding:17px 20px;
  border-radius:15px;
  background:#172033;
  border:1px solid #293a55;
}

.cart .total span{
  color:#cbd5e1;
  font-size:13px;
  font-weight:700;
}

.cart .total b{
  color:#f4c65d;
  font-size:24px;
  font-weight:900;
}

/* WhatsApp */

.cart > #whatsapp{
  position:relative;
  z-index:1;
  margin:16px 28px 27px;
  width:calc(100% - 56px);
  min-height:51px;
  border:0;
  border-radius:13px;
  background:#172033;
  color:#fff;
  font-size:13px;
  font-weight:900;
  box-shadow:0 8px 20px rgba(15,23,42,.16);
  transition:.2s ease;
}

.cart > #whatsapp:hover{
  background:#202f47;
  transform:translateY(-2px);
}

@media(max-width:520px){

  .cart{
    border-radius:20px;
  }

  .cart .head{
    padding:20px 17px;
  }

  .cart .head > div{
    gap:10px;
  }

  .cart .head > div::before{
    width:40px;
    height:40px;
    border-radius:12px;
    font-size:18px;
  }

  .cart .head h2{
    font-size:19px;
  }

  .cart .head #clear{
    min-height:35px;
    padding:0 12px;
  }

  #cartItems{
    padding:13px 17px;
  }

  #cartItems:empty::before{
    min-height:65px;
    font-size:11px;
  }

  .cart .total{
    margin:3px 17px 0;
    padding:14px 15px;
  }

  .cart .total b{
    font-size:20px;
  }

  .cart > #whatsapp{
    margin:13px 17px 19px;
    width:calc(100% - 34px);
    min-height:47px;
  }

}


/* =====================================================
   CART ITEMS — HOME PAGE THEME
   ===================================================== */

.cartrow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  padding:16px 18px;
  margin:8px 0;
  border:1px solid #e8edf2;
  border-left:3px solid #d99a16;
  border-radius:15px;
  background:#fff;
  box-shadow:0 5px 15px rgba(15,23,42,.05);
}

.cartrow-info{
  min-width:0;
  flex:1;
}

.cartrow-name{
  color:#172033;
  font-size:15px;
  font-weight:900;
  margin-bottom:5px;
}

.cartrow-info small{
  color:#7b8798;
  font-size:11px;
}

.cartrow-actions{
  display:flex;
  align-items:center;
  gap:12px;
}

.qty-control{
  display:flex;
  align-items:center;
  gap:10px;
  padding:4px;
  border-radius:10px;
  background:#fff8e8;
  border:1px solid #f3dfad;
}

.qty-control button{
  width:29px;
  height:29px;
  border:0;
  border-radius:8px;
  background:#172033;
  color:#f4c65d;
  font-size:18px;
  line-height:1;
  cursor:pointer;
}

.qty-control b{
  min-width:18px;
  text-align:center;
  color:#172033;
  font-size:13px;
}

.cartrow-subtotal{
  min-width:85px;
  text-align:right;
  color:#172033;
  font-size:14px;
}

.cart-remove{
  width:34px;
  height:34px;
  border:1px solid #f0d3d3;
  border-radius:9px;
  background:#fff7f7;
  color:#dc2626;
  cursor:pointer;
}

.cart-remove:hover{
  background:#fee2e2;
}

.cart-empty{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  min-height:190px;
  padding:25px;
  border:1px dashed rgba(183,121,11,.30);
  border-radius:18px;
  background:linear-gradient(135deg,#fffdf6,#fff8e8);
  text-align:center;
}

.cart-empty-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  width:58px;
  height:58px;
  margin-bottom:10px;
  border-radius:18px;
  background:#172033;
  font-size:27px;
  box-shadow:0 8px 18px rgba(15,23,42,.14);
}

.cart-empty strong{
  color:#172033;
  font-size:16px;
  margin-bottom:4px;
}

.cart-empty span{
  color:#7b8798;
  font-size:12px;
  margin-bottom:15px;
}

.cart-shop-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:39px;
  padding:0 17px;
  border-radius:10px;
  background:#172033;
  color:#f4c65d;
  text-decoration:none;
  font-size:11px;
  font-weight:900;
  transition:.2s ease;
}

.cart-shop-btn:hover{
  transform:translateY(-2px);
}

@media(max-width:650px){

  .cartrow{
    align-items:flex-start;
    flex-direction:column;
    gap:12px;
    padding:14px;
  }

  .cartrow-actions{
    width:100%;
    justify-content:space-between;
  }

  .cartrow-subtotal{
    min-width:auto;
  }

}

@media(max-width:420px){

  .cartrow-actions{
    gap:7px;
  }

  .qty-control{
    gap:6px;
  }

  .cartrow-subtotal{
    font-size:13px;
  }

}

